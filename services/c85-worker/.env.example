# C85 worker environment template. Every value is a server-side secret.
# Never place any of these in the Lovable frontend bundle.

# --- identity -----------------------------------------------------------------
C85_MODEL_VERSION=c85-multi-meta-r1
C85_WORKER_ID=c85-worker-1
C85_BUILD_SHA=

# --- artifacts ----------------------------------------------------------------
# Directory holding models/, fixtures/ and feature_order.json from C85_Lovable_Kit.zip
C85_ARTIFACT_DIR=/artifacts

# --- backend (Lovable Cloud / Supabase) ---------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- authenticated gateway back into the app ----------------------------------
# The app route that accepts signed decisions and drives the existing webhook.
C85_GATEWAY_URL=https://project--23a724c5-6c5b-4434-85e6-dc54b111c7e2.lovable.app/api/public/hooks/c85-decision
# Shared HMAC-SHA256 signing secret; must equal the C85_GATEWAY_SECRET stored in
# the project's backend secrets.
C85_GATEWAY_SECRET=

# --- market data feeds --------------------------------------------------------
BINANCE_SPOT_WS=wss://stream.binance.com:9443/stream
BINANCE_UM_WS=wss://fstream.binance.com/stream
BINANCE_CM_WS=wss://dstream.binance.com/stream
BINANCE_SPOT_REST=https://api.binance.com
BINANCE_DATA_VISION=https://data.binance.vision

# --- Kalshi -------------------------------------------------------------------
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
KALSHI_SERIES_TICKER=KXBTC15M
# Optional authenticated access (read-only is sufficient for settlement/trades).
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PEM=

# --- operational --------------------------------------------------------------
C85_PUBLICATION_DEADLINE_MS=5000
# Compute budget reserved before the T+5s ceiling; packet freezes at
# T + (deadline - budget). Measured, not assumed.
C85_COMPUTE_BUDGET_MS=1200
C85_HEARTBEAT_SECONDS=15
C85_HTTP_PORT=8080
# Fail closed. Only set true once every feed and ancestor expert is connected
# and the integration proof suite passes.
C85_ALLOW_LIVE_PUBLICATION=false
