# C85 offline bootstrap / refit job.
#
# This image is NOT the serving worker. It runs the original historical
# producers and the original scheduled fits, then exports and publishes a
# versioned deployment bundle. It is intended to run as a scheduled job (daily
# after the UTC roll, monthly for the auxiliary refit), not as a web service.
#
#   docker build -f Dockerfile.bootstrap -t c85-bootstrap .
#   docker run --rm -e C85_OPS_URL=... -e C85_GATEWAY_SECRET=... \
#     -v c85-cache:/app/evaluation-fixtures/cache c85-bootstrap \
#     python -m bootstrap.cli advance
#
# The cache volume is what makes the job resumable: completed stages are skipped
# by cursor, so a restart never triggers a full-history rebuild.
FROM python:3.12.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

COPY requirements.lock.txt ./
RUN pip install --no-cache-dir -r requirements.lock.txt

COPY src/ ./src/
COPY continuation/ ./continuation/
COPY bootstrap/ ./bootstrap/
COPY artifacts/ ./artifacts/

CMD ["python", "-m", "bootstrap.cli", "refit-status"]
